# Kanonik site adresi. www / http yönlendirmesi bu host'a yapılmalıdır.
PUBLIC_SITE_URL=https://vora.app

# Yalnızca gerçek production domaininde true. Preview ve geliştirme noindex kalır.
PUBLIC_SITE_INDEXABLE=false

# Boşsa kök .env içindeki EXPO_PUBLIC_SUPABASE_* değerleri kullanılır.
# Servis rolü anahtarı bu uygulamada okunmaz.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/tr/app/vora-x/id6777120091?l=tr
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.litxtech.vora

# Yalnızca sunucu. NEXT_PUBLIC_ öneki kullanma. Anahtar tarayıcıya gitmez.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
