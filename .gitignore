# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
.metro-cache/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
google-services.json

# local Supabase CLI link/state (project refs, pooler URLs)
supabase/.temp/

# local Expo bundle/check artifacts
.expo-bundle-check/
.expo-livekit-check/
.expo-tmp-*/

# typescript
*.tsbuildinfo

# Vora web (Next.js) — mobil Expo derlemesinden ayrı
web/.next/
web/out/

# generated native folders
/ios
/android

# vendor build sources (AAR artifacts live in vendor/android-m2)
/vendor/_src/
